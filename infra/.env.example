# Copy to ".env" and fill in. Never commit ".env" to a repository.
# Odoo refuses to start if the database user is "postgres": use "odoo".
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_PASSWORD
# Server LAN IP to restrict access to that interface (e.g. 192.168.1.50). 0.0.0.0 = all.
ODOO_BIND_IP=0.0.0.0
ODOO_DB_NAME=greenmug_prod
# Backups (used by scripts\backup_prod.ps1)
BACKUP_DIR=D:\backups\greenmug
BACKUP_KEEP_DAYS=14
# Off-site copy folder (network drive / cloud-synced folder). Leave empty to skip.
BACKUP_COPY_DIR=
